@page
@model IndexModel
@{
    ViewData["Title"] = "Petstore";
}

<div class="text-center">
    <h1 class="display-4">Petstore orders</h1>
    <p class="lead">Manage pet orders through the Swagger Petstore API.</p>
    <div class="d-grid gap-2 col-6 mx-auto">
        <a class="btn btn-primary" asp-page="/CreateOrder">Create a pet order</a>
        <a class="btn btn-outline-primary" asp-page="/ViewOrder">View an order</a>
    </div>
</div>
