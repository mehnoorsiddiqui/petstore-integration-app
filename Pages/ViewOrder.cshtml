@page
@model PetstoreWeb.Pages.ViewOrderModel
@{
    ViewData["Title"] = "View an order";
}

<h1>View an order</h1>

<p>Look up an order by its id and see its details.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="OrderId" class="form-label">Order id</label>
        <input asp-for="OrderId" class="form-control" />
        <span asp-validation-for="OrderId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">View order</button>
</form>

@if (Model.Order is not null)
{
    <hr />
    <h2>Order details</h2>
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Order.Id</dd>
        <dt class="col-sm-2">Pet id</dt>
        <dd class="col-sm-10">@Model.Order.PetId</dd>
        <dt class="col-sm-2">Quantity</dt>
        <dd class="col-sm-10">@Model.Order.Quantity</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@PetstoreWeb.Pages.ViewOrderModel.FormatStatus(Model.Order.Status)</dd>
        <dt class="col-sm-2">Ship date</dt>
        <dd class="col-sm-10">@Model.Order.ShipDate</dd>
        <dt class="col-sm-2">Complete</dt>
        <dd class="col-sm-10">@Model.Order.Complete</dd>
    </dl>
}
else if (Model.Message is not null)
{
    <hr />
    <div class="alert alert-danger" role="alert">
        @Model.Message
    </div>
}
